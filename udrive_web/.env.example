# Railway → udrive_web service → Variables. These are PUBLIC values (they end up
# in the browser) — never put a password, key or database URL here.

# The API's public address (same one the app uses), no trailing slash.
NEXT_PUBLIC_API_URL=https://api.example.com

# This website's own address, used for canonical links, sitemap.xml and Open Graph.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# WhatsApp number shown on the site, digits only with country code (92...).
NEXT_PUBLIC_WHATSAPP=923000000000

# Play Store link of the UDrive app.
NEXT_PUBLIC_PLAY_URL=https://play.google.com/store/apps/details?id=com.wabwar.udrive
