<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>false</InvariantGlobalization>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <RootNamespace>UDrive.Api</RootNamespace>
    <AssemblyName>UDrive.Api</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="EFCore.NamingConventions" Version="10.0.1" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.10" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL.NetTopologySuite" Version="10.0.3" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Infrastructure/Persistence/Migrations/*.sql" />
    <EmbeddedResource Include="Infrastructure/Persistence/Scripts/*.sql" />
    <!-- The privacy policy, terms and account-deletion page. Embedded rather
         than copied to disk so the pages Google Play points at cannot go
         missing from a deployment.
         WithCulture="false": without it MSBuild reads ".en" / ".ur" in the
         file names as a culture and moves these files into satellite
         assemblies, so the main assembly never contains them. -->
    <EmbeddedResource Include="Content/legal/*.md" WithCulture="false" />
  </ItemGroup>
</Project>