<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 8+ launcher icon: navy plate, lime pin, each in its own layer so the
    launcher can mask them to whatever shape the device uses and parallax them
    independently.

    <monochrome> is the Android 13+ themed icon. Without it the launcher falls
    back to shrinking the full-colour icon into a grey circle, which is how an
    app ends up looking unfinished on exactly the phones running the newest OS.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
